{
  "name": "Notification",
  "type": "object",
  "properties": {
    "destinataire_email": {
      "type": "string",
      "title": "Email destinataire"
    },
    "destinataire_role": {
      "type": "string",
      "title": "R\u00f4le destinataire (admin, livreur, client, partenaire, commercial, annonceur)"
    },
    "titre": {
      "type": "string",
      "title": "Titre"
    },
    "message": {
      "type": "string",
      "title": "Message"
    },
    "type": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "success",
        "danger"
      ],
      "title": "Type"
    },
    "lue": {
      "type": "boolean",
      "title": "Lue",
      "default": false
    },
    "course_id": {
      "type": "string",
      "title": "Course li\u00e9e (optionnel)"
    },
    "target_screen": {
      "type": "string",
      "title": "\u00c9cran cible (ex: /course-livreur/123)"
    },
    "target_entity_id": {
      "type": "string",
      "title": "ID de l'entit\u00e9 li\u00e9e (course, commande, profil\u2026)"
    },
    "target_entity_type": {
      "type": "string",
      "title": "Type d'entit\u00e9 (course, commande, profil, transaction, publicite)"
    },
    "target_section": {
      "type": "string",
      "title": "Section admin (gestion-profils, gestion-transactions\u2026)"
    },
    "notification_key": {
      "type": "string",
      "title": "Cl\u00e9 de d\u00e9duplication (email__type__entityId__titre)",
      "description": "Cl\u00e9 unique pour \u00e9viter les doublons dans une fen\u00eatre de 30 secondes"
    }
  },
  "required": [
    "destinataire_email",
    "titre",
    "message",
    "type"
  ]
}