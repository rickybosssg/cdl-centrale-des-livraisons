{
  "name": "FcmToken",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "ID utilisateur",
      "index": true
    },
    "user_email": {
      "type": "string",
      "title": "Email utilisateur",
      "index": true
    },
    "token": {
      "type": "string",
      "title": "Token FCM",
      "index": true,
      "unique": true
    },
    "device_id": {
      "type": "string",
      "title": "ID appareil",
      "index": true
    },
    "device_type": {
      "type": "string",
      "enum": [
        "android_native",
        "web",
        "ios"
      ],
      "title": "Type d'appareil",
      "default": "android_native"
    },
    "platform": {
      "type": "string",
      "title": "Plateforme",
      "default": "android"
    },
    "active_profile_type": {
      "type": "string",
      "title": "Profil actif au moment de l'enregistrement",
      "description": "Ex: client, livreur, admin \u2014 mis \u00e0 jour \u00e0 chaque login et switch profil"
    },
    "registered_at": {
      "type": "string",
      "title": "Date d'enregistrement"
    },
    "last_used": {
      "type": "string",
      "title": "Derni\u00e8re utilisation"
    },
    "last_seen": {
      "type": "string",
      "title": "Derni\u00e8re synchronisation (login/switch/heartbeat)"
    },
    "is_active": {
      "type": "boolean",
      "title": "Token actif",
      "default": true,
      "index": true
    }
  },
  "required": [
    "user_email",
    "token"
  ]
}