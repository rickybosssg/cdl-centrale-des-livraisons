{
  "name": "FcmToken",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "ID utilisateur",
      "index": true
    },
    "user_email": {
      "type": "string",
      "title": "Email utilisateur",
      "index": true
    },
    "token": {
      "type": "string",
      "title": "Token FCM",
      "index": true,
      "unique": true
    },
    "device_id": {
      "type": "string",
      "title": "ID appareil",
      "index": true
    },
    "device_type": {
      "type": "string",
      "enum": [
        "android_native",
        "web",
        "ios"
      ],
      "title": "Type d'appareil",
      "default": "android_native"
    },
    "platform": {
      "type": "string",
      "title": "Plateforme",
      "default": "android"
    },
    "registered_at": {
      "type": "string",
      "title": "Date d'enregistrement"
    },
    "last_used": {
      "type": "string",
      "title": "Derni\u00e8re utilisation"
    },
    "is_active": {
      "type": "boolean",
      "title": "Token actif",
      "default": true,
      "index": true
    }
  },
  "required": [
    "user_email",
    "token"
  ],
  "rls": {
    "create": {
      "user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_email": "{{user.email}}"
    },
    "delete": {
      "user_email": "{{user.email}}"
    }
  }
}