{
  "name": "FcmToken",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "title": "Email utilisateur",
      "index": true
    },
    "token": {
      "type": "string",
      "title": "Token FCM",
      "index": true
    },
    "device_type": {
      "type": "string",
      "enum": [
        "android_native",
        "web",
        "ios"
      ],
      "title": "Type d'appareil",
      "default": "android_native"
    },
    "registered_at": {
      "type": "string",
      "title": "Date d'enregistrement"
    },
    "last_used": {
      "type": "string",
      "title": "Derni\u00e8re utilisation"
    },
    "is_active": {
      "type": "boolean",
      "title": "Token actif",
      "default": true
    }
  },
  "required": [
    "user_email",
    "token"
  ]
}