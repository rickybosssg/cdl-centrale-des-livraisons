{
  "name": "LivreurRating",
  "type": "object",
  "properties": {
    "course_id": {
      "type": "string",
      "title": "ID de la course"
    },
    "livreur_email": {
      "type": "string",
      "title": "Email du livreur"
    },
    "livreur_name": {
      "type": "string",
      "title": "Nom du livreur"
    },
    "client_email": {
      "type": "string",
      "title": "Email du client"
    },
    "client_name": {
      "type": "string",
      "title": "Nom du client"
    },
    "note": {
      "type": "number",
      "title": "Note (1-5 \u00e9toiles)",
      "minimum": 1,
      "maximum": 5
    },
    "commentaire": {
      "type": "string",
      "title": "Commentaire optionnel"
    }
  },
  "required": [
    "course_id",
    "livreur_email",
    "client_email",
    "note"
  ]
}