{
  "name": "WhatsappInbox",
  "type": "object",
  "properties": {
    "phone_number": {
      "type": "string",
      "title": "Num\u00e9ro WhatsApp client"
    },
    "client_name": {
      "type": "string",
      "title": "Nom client (si connu)"
    },
    "raw_message": {
      "type": "string",
      "title": "Message brut re\u00e7u"
    },
    "extracted_depart": {
      "type": "string",
      "title": "D\u00e9part extrait"
    },
    "extracted_destination": {
      "type": "string",
      "title": "Destination extraite"
    },
    "extracted_phone": {
      "type": "string",
      "title": "T\u00e9l\u00e9phone extrait"
    },
    "extracted_details": {
      "type": "string",
      "title": "D\u00e9tails colis extraits"
    },
    "extracted_type": {
      "type": "string",
      "enum": [
        "envoyer",
        "recuperer",
        "deplacement",
        "inconnu"
      ],
      "title": "Type de demande d\u00e9tect\u00e9"
    },
    "status": {
      "type": "string",
      "enum": [
        "recu",
        "incomplet",
        "pret_a_convertir",
        "converti",
        "erreur"
      ],
      "title": "Statut",
      "default": "recu"
    },
    "linked_course_id": {
      "type": "string",
      "title": "ID Course li\u00e9e"
    },
    "saisi_par": {
      "type": "string",
      "title": "Admin ayant saisi"
    },
    "note_admin": {
      "type": "string",
      "title": "Note interne admin"
    }
  },
  "required": [
    "phone_number",
    "raw_message",
    "status"
  ]
}