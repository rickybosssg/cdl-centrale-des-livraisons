{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "current_role": {
      "type": "string",
      "title": "R\u00f4le actif actuel (client, livreur, commercial, partenaire)",
      "enum": [
        "client",
        "livreur",
        "commercial",
        "partenaire"
      ]
    },
    "driver_online": {
      "type": "boolean",
      "title": "Livreur en ligne (actif dans ce r\u00f4le)",
      "default": false
    },
    "client_online": {
      "type": "boolean",
      "title": "Client en ligne",
      "default": false
    },
    "commercial_online": {
      "type": "boolean",
      "title": "Commercial en ligne",
      "default": false
    },
    "partner_online": {
      "type": "boolean",
      "title": "Partenaire en ligne",
      "default": false
    },
    "whatsapp_trigger_event": {
      "type": "string",
      "title": "Dernier \u00e9v\u00e9nement WA"
    },
    "whatsapp_message_text": {
      "type": "string",
      "title": "Message WhatsApp \u00e0 envoyer"
    },
    "whatsapp_recipient_role": {
      "type": "string",
      "title": "R\u00f4le destinataire WA"
    },
    "whatsapp_recipient_phone": {
      "type": "string",
      "title": "T\u00e9l\u00e9phone destinataire WA"
    },
    "whatsapp_ready": {
      "type": "boolean",
      "title": "Pr\u00eat pour Respond.io",
      "default": false
    },
    "whatsapp_sent": {
      "type": "boolean",
      "title": "Envoy\u00e9 par Respond.io",
      "default": false
    }
  },
  "required": []
}