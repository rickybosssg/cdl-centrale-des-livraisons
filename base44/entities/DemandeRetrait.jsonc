{
  "name": "DemandeRetrait",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "ID utilisateur"
    },
    "user_email": {
      "type": "string",
      "title": "Email utilisateur"
    },
    "user_nom": {
      "type": "string",
      "title": "Nom utilisateur"
    },
    "role": {
      "type": "string",
      "enum": [
        "livreur",
        "partenaire",
        "commercial"
      ],
      "title": "R\u00f4le"
    },
    "montant": {
      "type": "number",
      "title": "Montant demand\u00e9 (F CFA)"
    },
    "methode": {
      "type": "string",
      "enum": [
        "orange_money",
        "moov_money",
        "telecel_money",
        "cash"
      ],
      "title": "M\u00e9thode de retrait"
    },
    "numero_reception": {
      "type": "string",
      "title": "Num\u00e9ro de r\u00e9ception"
    },
    "nom_compte": {
      "type": "string",
      "title": "Nom du compte"
    },
    "statut": {
      "type": "string",
      "enum": [
        "en_attente",
        "valide",
        "refuse",
        "paye"
      ],
      "title": "Statut",
      "default": "en_attente"
    },
    "date_validation": {
      "type": "string",
      "title": "Date de validation"
    },
    "valide_par": {
      "type": "string",
      "title": "Valid\u00e9 par (email admin)"
    },
    "motif_refus": {
      "type": "string",
      "title": "Motif de refus"
    }
  },
  "required": [
    "user_email",
    "role",
    "montant",
    "methode",
    "numero_reception"
  ]
}