{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "title": "Email utilisateur"
    },
    "profile_type": {
      "type": "string",
      "enum": [
        "client",
        "livreur",
        "partenaire",
        "commercial"
      ],
      "title": "Type de profil"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "incomplet",
        "en_attente",
        "actif",
        "refuse",
        "suspendu",
        "bloque"
      ],
      "title": "Statut du profil",
      "default": "draft"
    },
    "is_active_profile": {
      "type": "boolean",
      "title": "Profil actuellement actif",
      "default": false
    },
    "completion_percentage": {
      "type": "number",
      "title": "Pourcentage de compl\u00e9tude (0-100)",
      "default": 0
    },
    "missing_fields": {
      "type": "string",
      "title": "Champs manquants (JSON array)"
    },
    "missing_documents": {
      "type": "string",
      "title": "Documents manquants (JSON array)"
    },
    "documents_json": {
      "type": "string",
      "title": "Documents fournis (JSON)"
    },
    "data_json": {
      "type": "string",
      "title": "Donn\u00e9es sp\u00e9cifiques au profil (JSON)"
    },
    "validated_at": {
      "type": "string",
      "title": "Date de validation"
    },
    "validated_by": {
      "type": "string",
      "title": "Email du validateur (admin)"
    },
    "suspended_at": {
      "type": "string",
      "title": "Date de suspension"
    },
    "deleted_at": {
      "type": "string",
      "title": "Date de suppression"
    },
    "deleted": {
      "type": "boolean",
      "title": "Profil supprim\u00e9 (soft delete)",
      "default": false
    },
    "refusal_reason": {
      "type": "string",
      "title": "Motif de refus"
    },
    "relance_count": {
      "type": "number",
      "title": "Nombre de relances envoy\u00e9es",
      "default": 0
    },
    "derniere_relance": {
      "type": "string",
      "title": "Date derni\u00e8re relance"
    }
  },
  "required": [
    "user_email",
    "profile_type",
    "status"
  ]
}