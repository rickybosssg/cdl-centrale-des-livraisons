{
  "name": "Bedou",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "ID utilisateur"
    },
    "user_email": {
      "type": "string",
      "title": "Email utilisateur",
      "index": true
    },
    "user_nom": {
      "type": "string",
      "title": "Nom utilisateur"
    },
    "solde_global": {
      "type": "number",
      "title": "Solde global (F CFA)",
      "default": 0
    },
    "solde_disponible_global": {
      "type": "number",
      "title": "Solde disponible global (F CFA)",
      "default": 0
    },
    "solde_bonus": {
      "type": "number",
      "title": "Solde bonus (non retirable, courses uniquement)",
      "default": 0
    },
    "bonus": {
      "type": "number",
      "title": "Bonus cumul\u00e9 (F CFA)",
      "default": 0
    },
    "bonus_recharge_count": {
      "type": "number",
      "title": "Nombre de recharges avec bonus re\u00e7u",
      "default": 0
    },
    "gains_totaux_livreur": {
      "type": "number",
      "title": "Gains totaux livreur (F CFA)",
      "default": 0
    },
    "gains_totaux_partenaire": {
      "type": "number",
      "title": "Gains totaux partenaire (F CFA)",
      "default": 0
    },
    "gains_totaux_commercial": {
      "type": "number",
      "title": "Gains totaux commercial (F CFA)",
      "default": 0
    },
    "depenses_totales_client": {
      "type": "number",
      "title": "D\u00e9penses totales client (F CFA)",
      "default": 0
    },
    "balance_blocked_commercial": {
      "type": "number",
      "title": "Gains commerciaux bloqu\u00e9s (F CFA)",
      "default": 0,
      "description": "Gains commerciaux bloqu\u00e9s jusqu'\u00e0 5000 F"
    },
    "statut_bedou": {
      "type": "string",
      "enum": [
        "actif",
        "suspendu"
      ],
      "title": "Statut Bedou",
      "default": "actif"
    },
    "date_creation": {
      "type": "string",
      "title": "Date de cr\u00e9ation"
    }
  },
  "required": [
    "user_email"
  ]
}