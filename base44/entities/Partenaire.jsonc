{
  "name": "Partenaire",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "title": "Email utilisateur"
    },
    "nom_commerce": {
      "type": "string",
      "title": "Nom du commerce / activit\u00e9"
    },
    "nom_responsable": {
      "type": "string",
      "title": "Nom du responsable"
    },
    "telephone": {
      "type": "string",
      "title": "T\u00e9l\u00e9phone"
    },
    "type_commerce": {
      "type": "string",
      "enum": [
        "Restaurant",
        "Pharmacie",
        "Boutique",
        "Alimentation",
        "Boissons",
        "Vitrine"
      ],
      "title": "Type de commerce"
    },
    "type_activite": {
      "type": "string",
      "title": "Type d'activit\u00e9 (pour Vitrine)"
    },
    "quartier": {
      "type": "string",
      "title": "Quartier"
    },
    "adresse": {
      "type": "string",
      "title": "Adresse"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "logo": {
      "type": "string",
      "title": "Logo URL"
    },
    "photo_principale": {
      "type": "string",
      "title": "Photo principale (couverture)"
    },
    "photo_couverture": {
      "type": "string",
      "title": "Photo de couverture"
    },
    "galerie_photos": {
      "type": "string",
      "title": "Galerie photos (JSON array URLs)"
    },
    "photos": {
      "type": "string",
      "title": "Photos (JSON)"
    },
    "videos": {
      "type": "string",
      "title": "Vid\u00e9os (JSON URLs)"
    },
    "video_presentation": {
      "type": "string",
      "title": "Vid\u00e9o de pr\u00e9sentation URL"
    },
    "catalogue_url": {
      "type": "string",
      "title": "URL Catalogue (PDF/image)"
    },
    "menu_images": {
      "type": "string",
      "title": "Images du menu (JSON array)"
    },
    "ouvert": {
      "type": "boolean",
      "title": "Ouvert / Actif"
    },
    "horaires": {
      "type": "string",
      "title": "Horaires d'ouverture"
    },
    "whatsapp": {
      "type": "string",
      "title": "WhatsApp"
    },
    "statut": {
      "type": "string",
      "enum": [
        "en_attente",
        "actif",
        "refuse",
        "suspendu"
      ],
      "title": "Statut"
    },
    "motif_refus": {
      "type": "string",
      "title": "Motif de refus"
    },
    "statut_abonnement": {
      "type": "string",
      "enum": [
        "Actif",
        "Expir\u00e9",
        "Bloqu\u00e9"
      ],
      "title": "Statut abonnement"
    },
    "date_paiement_abonnement": {
      "type": "string",
      "title": "Date paiement abonnement"
    },
    "date_expiration_abonnement": {
      "type": "string",
      "title": "Date expiration abonnement"
    },
    "nombre_vues": {
      "type": "number",
      "title": "Nombre de vues"
    },
    "nombre_clics_commander": {
      "type": "number",
      "title": "Clics Commander"
    },
    "nombre_contacts": {
      "type": "number",
      "title": "Nombre de contacts WhatsApp"
    },
    "nombre_commandes": {
      "type": "number",
      "title": "Nombre commandes"
    },
    "chiffre_affaires": {
      "type": "number",
      "title": "Chiffre d'affaires total (FCFA)"
    },
    "note_admin": {
      "type": "string",
      "title": "Note admin"
    }
  },
  "required": [
    "user_email",
    "nom_commerce",
    "telephone",
    "type_commerce"
  ]
}