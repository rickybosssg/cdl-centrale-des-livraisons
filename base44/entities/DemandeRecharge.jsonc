{
  "name": "DemandeRecharge",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "ID utilisateur",
      "index": true
    },
    "user_email": {
      "type": "string",
      "title": "Email utilisateur",
      "index": true
    },
    "user_name": {
      "type": "string",
      "title": "Nom utilisateur"
    },
    "montant": {
      "type": "number",
      "title": "Montant demand\u00e9 (F CFA)"
    },
    "bonus": {
      "type": "number",
      "title": "Bonus appliqu\u00e9 (F CFA)",
      "default": 0
    },
    "montant_total": {
      "type": "number",
      "title": "Montant total avec bonus (F CFA)"
    },
    "methode_paiement": {
      "type": "string",
      "enum": [
        "orange_money",
        "moov_money",
        "telecel_money",
        "cash"
      ],
      "title": "M\u00e9thode de paiement"
    },
    "preuve_paiement_url": {
      "type": "string",
      "title": "URL preuve de paiement"
    },
    "statut": {
      "type": "string",
      "enum": [
        "en_attente",
        "valide",
        "refuse"
      ],
      "title": "Statut",
      "default": "en_attente",
      "index": true
    },
    "type": {
      "type": "string",
      "title": "Type de transaction",
      "default": "recharge_bedou"
    },
    "date_validation": {
      "type": "string",
      "title": "Date de validation"
    },
    "valide_par": {
      "type": "string",
      "title": "Valid\u00e9 par (email admin)"
    },
    "motif_refus": {
      "type": "string",
      "title": "Motif de refus"
    }
  },
  "required": [
    "user_email",
    "montant",
    "methode_paiement"
  ]
}