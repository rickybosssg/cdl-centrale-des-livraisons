{
  "name": "Publicite",
  "type": "object",
  "properties": {
    "titre": {
      "type": "string",
      "title": "Titre"
    },
    "image_url": {
      "type": "string",
      "title": "Image URL (principale)"
    },
    "images": {
      "type": "string",
      "title": "Images (JSON array URLs)"
    },
    "lien_url": {
      "type": "string",
      "title": "Lien de redirection"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "placement": {
      "type": "string",
      "enum": [
        "dashboard_client",
        "dashboard_livreur",
        "dashboard_partenaire",
        "dashboard_commercial",
        "dashboard_admin",
        "accueil",
        "toutes_pages"
      ],
      "title": "Emplacement"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Profils cibl\u00e9s",
      "description": "Ex: ['client'], ['livreur', 'client'], ['all']"
    },
    "date_debut": {
      "type": "string",
      "title": "Date de d\u00e9but"
    },
    "date_fin": {
      "type": "string",
      "title": "Date de fin"
    },
    "active": {
      "type": "boolean",
      "title": "Active"
    },
    "impressions": {
      "type": "number",
      "title": "Impressions",
      "default": 0
    },
    "clics": {
      "type": "number",
      "title": "Clics",
      "default": 0
    },
    "nom_annonceur": {
      "type": "string",
      "title": "Nom de l'annonceur"
    },
    "deleted": {
      "type": "boolean",
      "title": "Supprim\u00e9 (soft delete)",
      "default": false
    },
    "deleted_at": {
      "type": "string",
      "title": "Date de suppression"
    },
    "suspended": {
      "type": "boolean",
      "title": "Suspendu",
      "default": false
    },
    "suspended_at": {
      "type": "string",
      "title": "Date de suspension"
    }
  },
  "required": [
    "titre",
    "placement"
  ]
}