{
  "name": "WhatsAppNotificationLog",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "title": "Type d'\u00e9v\u00e9nement"
    },
    "recipient_role": {
      "type": "string",
      "title": "R\u00f4le destinataire"
    },
    "recipient_name": {
      "type": "string",
      "title": "Nom destinataire"
    },
    "recipient_phone": {
      "type": "string",
      "title": "T\u00e9l\u00e9phone destinataire"
    },
    "message_text": {
      "type": "string",
      "title": "Message \u00e0 envoyer"
    },
    "entity_id": {
      "type": "string",
      "title": "ID entit\u00e9 li\u00e9e"
    },
    "entity_type": {
      "type": "string",
      "title": "Type entit\u00e9 (course, profil, bedou...)"
    },
    "priority": {
      "type": "string",
      "enum": [
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal"
    },
    "whatsapp_ready": {
      "type": "boolean",
      "title": "Pr\u00eat pour Respond.io",
      "default": false,
      "description": "Respond.io surveille ce champ pour d\u00e9clencher le workflow"
    },
    "whatsapp_sent": {
      "type": "boolean",
      "title": "Envoy\u00e9 par Respond.io",
      "default": false,
      "description": "Respond.io met ce champ \u00e0 true apr\u00e8s envoi"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "failed",
        "skipped"
      ],
      "title": "Statut",
      "default": "pending"
    },
    "error_message": {
      "type": "string",
      "title": "Message d'erreur"
    },
    "retry_count": {
      "type": "number",
      "title": "Nombre de tentatives",
      "default": 0
    },
    "sent_at": {
      "type": "string",
      "title": "Envoy\u00e9 le"
    },
    "provider": {
      "type": "string",
      "title": "Fournisseur",
      "default": "respond_io"
    }
  },
  "required": [
    "event_type",
    "recipient_phone",
    "message_text"
  ]
}